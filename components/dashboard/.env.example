# Copy this file to components/dashboard/.env and fill in values from your Supabase project.
REACT_APP_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
REACT_APP_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

# Older Supabase projects may use their legacy anon key instead of the publishable key above.
# If used, comment out REACT_APP_SUPABASE_PUBLISHABLE_KEY and uncomment this line.
# REACT_APP_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
